# Copy this file to ".env" and fill in your own values. NEVER commit the real .env file.

# AI model key (optional - without it the app runs in rule-based fallback mode)
ANTHROPIC_API_KEY=your-api-key-here
# Model used in AI mode (optional)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Business timezone used for opening hours and "now" (optional)
BUSINESS_TIMEZONE=Europe/Riga

# Password for the Admin Dashboard - change it!
ADMIN_PASSWORD=change-me

# Where the SQLite file lives (optional; default: smartbook.db next to the code)
# DB_PATH=/data/smartbook.db
